# OpsPulse for Alexa+ Environment Configuration
# Copy this file to .env and configure your environment

# Server Networking
PORT=8000
HOST=0.0.0.0

# AWS Credentials for Amazon Bedrock Runtime
# If credentials are not provided, OpsPulse automatically runs in high-fidelity mock fallback mode
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-optional-session-token

# Foundation Model Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
